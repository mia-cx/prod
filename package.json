{
  "name": "prod",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --filter='./apps/*'",
    "start": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run start --filter='./apps/*'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm boundaries:check && turbo run lint typecheck test build",
    "pack:check": "turbo run pack:check",
    "boundaries:check": "node scripts/check-package-boundaries.mjs",
    "db:generate": "turbo run db:generate --filter='./apps/*'",
    "db:migrate": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run db:migrate --filter='./apps/*'",
    "commands:register": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run commands:register --filter='./apps/*'",
    "deploy": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run deploy --filter='./apps/*'"
  },
  "devDependencies": {
    "eslint": "10.7.0",
    "pnpm": "11.13.0",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10"
  }
}
